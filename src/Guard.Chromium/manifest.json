{
  "manifest_version": 3,
  "name": "Guard",
  "version": "1.0.0",
  "description": "Blocks restricted keywords and sites. Managed by the Guard service on this computer.",
  "minimum_chrome_version": "116",

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "nativeMessaging"
  ],

  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
